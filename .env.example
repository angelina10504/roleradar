# Copy to .env and fill in. .env is gitignored. Never commit real values.
#
# Note on where each value is actually consumed. n8n does not read this file.
# Credentials for the Anthropic and Postgres nodes live in n8n's own encrypted
# credential store, entered by hand in the UI. The keys below marked [n8n UI]
# are recorded here as documentation of what you need to create, not as config
# that gets loaded. The ones marked [api] and [compose] are read for real.

# --- Anthropic --------------------------------------------------------------
# [n8n UI] Header Auth credential, header name: x-api-key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Postgres (the warehouse) -----------------------------------------------
# Postgres, not BigQuery. BigQuery's no-card Sandbox blocks streaming inserts
# and DML, and n8n's BigQuery node writes with insertAll, which is the
# streaming insert API, so it cannot write to a Sandbox project at all.
# See CLAUDE.md, "Why Postgres".
#
# [compose] Password for the roleradar database user.
# [n8n UI]  Same value, in a Postgres credential. From inside the n8n container
#           the host is `postgres`, not `localhost`.
# [api]     Read by the FastAPI app.
POSTGRES_PASSWORD=
POSTGRES_DB=roleradar
POSTGRES_USER=roleradar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- n8n (docker-compose) ---------------------------------------------------
# [compose] Encryption key for n8n's credential store. Losing it means
# re-entering every credential. Generate with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC

# --- Pipeline tuning --------------------------------------------------------
# [n8n UI] Search terms for the Remotive query, one workflow run per term
REMOTIVE_SEARCH_TERMS=n8n,data engineer,machine learning
# [n8n UI] Hard cap on items leaving the Limit node. This is the cost
# control: one item = one billed Anthropic call, so DEV_JOB_LIMIT is the
# ceiling on Anthropic spend per workflow run. Raise it deliberately, never
# by accident. Remotive returns hundreds of postings per search term.
DEV_JOB_LIMIT=5
# The extraction version is NOT set here. It is the EXTRACTION_VERSION constant
# in validator/validate.js and nowhere else. It reaches the rows because that
# file is what runs in the n8n Code node. An EXTRACTION_VERSION line in your
# own .env does nothing and can be deleted.

# --- Dashboard --------------------------------------------------------------
# [api]
API_PORT=8000

# --- Hosted warehouse (Neon) ------------------------------------------------
# [api] Set in Vercel's environment variables, and locally in .env for
# migrations and testing. Never committed.
#
# Use the POOLED connection string -- the host contains "-pooler". Serverless
# functions open and drop connections constantly and the direct endpoint runs
# out. Keep ?sslmode=require; Neon refuses unencrypted connections.
#
# If set, this overrides every POSTGRES_* value above. In Vercel it is named
# DATABASE_URL, which is what api/main.py actually reads.
NEON_DATABASE_URL=

# [api] Seconds to wait for a connection before answering 503. Default 8.
# Neon's free tier suspends the compute when idle; 3s reports "down" for a
# database that is merely asleep.
DB_TIMEOUT_SECONDS=8

# --- Pipeline health (GET /api/pipeline-status) ------------------------------
# [api] All optional. The defaults are shown. See README, "Pipeline health".
# How often a run is expected, and how late it may be before it is "overdue".
EXPECTED_RUN_INTERVAL_HOURS=24
RUN_GRACE_MINUTES=60
# A run still marked running after this long is reported as stale.
STALE_RUN_MINUTES=15
# How far back "recent failures" looks.
RECENT_FAILURE_HOURS=24

# --- Operator token (optional) ------------------------------------------------
# [api] Unset by default, and that is a supported state: the API then has no
# operator mode and error messages are readable only in the database.
# Set it to read them through the API with the X-Ops-Token header. Must be at
# least 24 characters or it is ignored. Generate with: openssl rand -hex 24
# Set in Vercel's environment variables. Never commit a real value.
OPS_TOKEN=

# --- External freshness check (monitor/check_freshness.py) -------------------
# Not read by the API or by n8n. Set as GitHub repository VARIABLES, not
# secrets: the URL is a public read-only endpoint and no credential is sent.
# ROLERADAR_SCHEDULE must match the n8n Schedule Trigger, in ROLERADAR_SCHEDULE_TZ.
ROLERADAR_STATUS_URL=https://your-deployment.example/api/pipeline-status
ROLERADAR_SCHEDULE=06:00
ROLERADAR_SCHEDULE_TZ=Asia/Kolkata
ROLERADAR_GRACE_MINUTES=90
